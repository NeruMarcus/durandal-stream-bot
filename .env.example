# Durandal — пример конфигурации. Скопируйте в .env и заполните.
# Копирование (PowerShell): Copy-Item .env.example .env

# LLM: только локальный Ollama — без VPN, без лимитов, без интернета.
# Ставится: https://ollama.com/download/windows , затем:
#   ollama pull gemma3:4b
#   ollama create durandal-gemma -f Modelfile
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=durandal-gemma
# Если сервер Ollama закрыт (вышел трей, перезагрузка), vision молча уходит
# в заготовки, пока его не поднимут руками. true — бот сам поднимет
# `ollama serve` и подождёт до 25с; false — только скажет в лог.
OLLAMA_AUTOSTART=true

# Twitch (EventSub, twitchio v3). Скопы токена: user:read:chat user:bot channel:bot.
# user:bot + channel:bot нужны, потому что conduit едет на app-токене
# (см. README troubleshooting «403 missing proper authorization»).
# ID можно взять на https://twitchtokengenerator.com
TWITCH_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_ID=
TWITCH_CHANNEL_ID=
TWITCH_CHANNEL=

# RVC: true/false. Без rvc_env используется чистый edge-tts.
USE_RVC=false
# Устройство RVC-демона: cpu (дефолт) или cuda:0. Под нагрузкой игры VRAM
# забит, и CUDA-демон встаёт на загрузке rmvpe — реплики идут без конверсии;
# на CPU та же модель даёт тот же тембр за ~11-20с и разгружает видеокарту.
RVC_DEVICE=cpu

# Голоса edge-tts по приоритету через запятую. Первый — основной; если сервис
# «замолкает» по конкретному голосу (NoAudioReceived), бот берёт следующий.
# Можно задать сдвиг RVC в полутонах: "голос:сдвиг" (по умолчанию +1).
# Пример с женским резервом (октава вниз, иначе Дюрандаль заговорит высоко):
#   TTS_VOICES=ru-RU-DmitryNeural,en-US-AndrewMultilingualNeural,ru-RU-SvetlanaNeural:-11
TTS_VOICES=ru-RU-DmitryNeural,en-US-AndrewMultilingualNeural,en-US-BrianMultilingualNeural

# Интервал vision-комментариев (сек)
COMMENT_INTERVAL=45

# Индекс монитора для захвата (0 = основной)
MONITOR_INDEX=1

# Кулдаун ответов в чат (сек)
CHAT_COOLDOWN=3.0

# GitHub token — только для torch.hub при первом скачивании моделей (см. README).
# После прогрева убрать либо выдать токен без прав (public read).
# GITHUB_TOKEN=
