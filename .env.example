# Durandal — пример конфигурации. Скопируйте в .env и заполните.
# Копирование (PowerShell): Copy-Item .env.example .env

# LLM: только локальный Ollama — без VPN, без лимитов, без интернета.
# Ставится: https://ollama.com/download/windows , затем:
#   ollama pull gemma3:4b
#   ollama create durandal-gemma -f Modelfile
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=durandal-gemma

# Twitch (EventSub, twitchio v3). Скопы токена: user:read:chat.
# ID можно взять на https://twitchtokengenerator.com
TWITCH_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_ID=
TWITCH_CHANNEL_ID=
TWITCH_CHANNEL=

# RVC: true/false. Без rvc_env используется чистый edge-tts.
USE_RVC=false

# Интервал vision-комментариев (сек)
COMMENT_INTERVAL=45

# Индекс монитора для захвата (0 = основной)
MONITOR_INDEX=1

# Кулдаун ответов в чат (сек)
CHAT_COOLDOWN=3.0

# GitHub token — только для torch.hub при первом скачивании моделей (см. README).
# После прогрева убрать либо выдать токен без прав (public read).
# GITHUB_TOKEN=
